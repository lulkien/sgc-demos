# Build recipes for the current host and the board (aarch64), mirroring the
# simple-graphics-controller linkage convention: musl = fully static, gnu =
# dynamically linked (the board runs glibc).
#
#   just                     release build for the current host
#   just build-musl-aarch64  fully static aarch64 musl build (board)
#   just build-gnu-aarch64   dynamic aarch64 (gnu) build (board)
#   just build-gnu-aarch64-input
#                            gnu build with input support (--features input)
#                            needs aarch64 libinput.pc to build; the board
#                            needs libinput10 installed to run
#   just clean               remove ./target
#
# Default renderer is software (see Cargo.toml). For the GL flavor build
# with the femtovg feature instead:
#   cargo build --release --no-default-features --features femtovg \
#       --target aarch64-unknown-linux-gnu

default: build

build:
    cargo build --release

# arm64 system libs (freetype for fontique, board libgbm for the GL flavor)
# live in the arm64 pkg-config dir; allow cross-linking against them.
pkg_env := 'PKG_CONFIG_ALLOW_CROSS=1 PKG_CONFIG_PATH=/usr/lib/aarch64-linux-gnu/pkgconfig'

# Dynamically linked aarch64 (gnu) build — the board runs glibc. Font libs
# (freetype etc. for fontique) are statically linked from the arm64 pkg-config
# dir: the board's minimal image has no libfreetype. fontique dlopens
# libfontconfig at runtime, so no libfontconfig link-time dep. (The femtovg GL
# flavor needs dynamic board libgbm instead: drop PKG_CONFIG_ALL_STATIC=1 for
# that build.)
build-gnu-aarch64:
    {{pkg_env}} PKG_CONFIG_ALL_STATIC=1 cargo build --release --target aarch64-unknown-linux-gnu

# gnu build with input support (--features input): libinput over the
# @sgc-granted devices. Cross-build needs an aarch64 libinput.pc in the
# pkg-config dir; the board needs libinput10 (apt install libinput10). Only
# meaningful with the gnu flavor — musl static cannot link system libinput.
build-gnu-aarch64-input:
    {{pkg_env}} PKG_CONFIG_ALL_STATIC=1 cargo build --release --features input --target aarch64-unknown-linux-gnu

# Fully static aarch64 musl build (musl.cc toolchain via ~/.cargo/bin
# symlinks); runs on any Alpine aarch64.
build-musl-aarch64:
    cargo build --release --target aarch64-unknown-linux-musl

clean:
    cargo clean
