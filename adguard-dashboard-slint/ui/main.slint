// The dashboard page: header, protection badge, four charts, two table rows and
// a footer. It only arranges components that live in their own files
// (theme.slint, types.slint, *-card.slint), so this file stays a layout.
//
// The page is laid out from the panel and never from a canvas of its own:
// header, badge and footer take fixed line boxes, the three card rows split the
// rest, and each table card shows the rows that fit the height it was given
// (table-card.slint). That is what makes the same markup fill a 1366x768 panel
// and a 1920x1080 one.
//
// Compiled to Rust by build.rs; slint-build follows the imports, so the types in
// types.slint become Rust structs (see ../src/view.rs).

import { Theme } from "theme.slint";
import { ChartData, TableData } from "types.slint";
import { ChartCard } from "chart-card.slint";
import { TableCard } from "table-card.slint";
import { ProtectionBadge } from "protection-badge.slint";

export component MainWindow inherits Window {
    // No width/height here on purpose: the linuxsgc backend sizes this window
    // from the DRM lease's mode, and Slint lays the page out at the size the
    // window ends up with. The offscreen --self-check sets the size it renders
    // at instead (src/selfcheck.rs), so it measures the panels it is given.

    // Publish the panel to the theme, which every length is derived from.
    init => { Theme.panel-w = self.width; Theme.panel-h = self.height; }
    changed width => { Theme.panel-w = self.width; }
    changed height => { Theme.panel-h = self.height; }

    background: Theme.page;

    in property <string> status-text: "starting";
    in property <color> status-color: Theme.muted;
    in property <bool> protection-known: false;
    in property <bool> protection-on: false;
    in property <string> protection-text: "Protection: unknown";
    in property <string> footer-version: "AdGuard Home";
    in property <string> footer-source: "";
    in property <[ChartData]> charts: [];
    in property <TableData> general;
    in property <TableData> top-clients;
    in property <TableData> top-queried;
    in property <TableData> top-blocked;

    Rectangle {
        width: 100%;
        height: 100%;

        VerticalLayout {
            padding: Theme.page-padding;
            spacing: Theme.page-gap;

            // header: title on the left, refresh status on the right
            HorizontalLayout {
                height: Theme.heading-line;
                spacing: 14px * Theme.scale;
                Text {
                    text: "AdGuard Home statistics";
                    color: Theme.text;
                    font-size: Theme.heading-size;
                    wrap: no-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.status-text;
                    color: root.status-color;
                    font-size: Theme.cell-size;
                    wrap: no-wrap;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    horizontal-stretch: 1;
                }
            }

            // the badge sits on its own line, left-aligned
            HorizontalLayout {
                height: Theme.badge-h;
                spacing: 0px;
                ProtectionBadge {
                    known: root.protection-known;
                    on: root.protection-on;
                    label: root.protection-text;
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
            }

            // row 1: the four chart cards.
            //
            // The width is computed, not stretched: a layout child keeps its
            // content's preferred width and horizontal-stretch only splits what
            // is left, so the card with the longest title used to come out
            // wider (378 / 379 / 470 / 425 px). min-width: 0px does not override
            // that in Slint; an explicit share of the row does, and it comes from
            // the theme (Theme.content-w) rather than from `parent.width` - see
            // the comment on content-w for the binding loop that avoids.
            HorizontalLayout {
                height: Theme.charts-h;
                spacing: Theme.page-gap;
                for chart in root.charts: ChartCard {
                    data: chart;
                    width: (Theme.content-w - (root.charts.length - 1) * Theme.page-gap) / root.charts.length;
                }
            }

            // row 2: general statistics | top clients
            HorizontalLayout {
                height: Theme.table-row-h;
                spacing: Theme.page-gap;
                TableCard { data: root.general; width: (Theme.content-w - Theme.page-gap) / 2; }
                TableCard { data: root.top-clients; width: (Theme.content-w - Theme.page-gap) / 2; }
            }

            // row 3: top queried domains | top blocked domains
            HorizontalLayout {
                height: Theme.table-row-h;
                spacing: Theme.page-gap;
                TableCard { data: root.top-queried; width: (Theme.content-w - Theme.page-gap) / 2; }
                TableCard { data: root.top-blocked; width: (Theme.content-w - Theme.page-gap) / 2; }
            }

            // footer: version | endpoint
            HorizontalLayout {
                height: Theme.footer-line;
                spacing: 14px * Theme.scale;
                Text {
                    text: root.footer-version;
                    color: Theme.muted;
                    font-size: Theme.footer-size;
                    wrap: no-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.footer-source;
                    color: Theme.muted;
                    font-size: Theme.footer-size;
                    wrap: no-wrap;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    horizontal-stretch: 1;
                }
            }
        }
    }
}
