import { Theme } from "theme.slint";
import { TableData, RowData } from "types.slint";
import { Card } from "card.slint";
import { SectionTitle } from "section-title.slint";

// One data row: label and value in columns stretched 3:1, the counterpart of the
// LVGL table whose column widths are fitted to the card. Long labels elide
// rather than wrap, so the row height stays uniform.
//
// The height is explicit on purpose: a layout child would otherwise stretch to
// fill the card, which makes every row 52px tall with the text pinned to the top
// and a dead gap under it. `vertical-alignment: center` puts the text in the
// middle of its own row. TableCard overrides the height with the one it computed
// from the card height; Theme.row-min is what a row looks like on its own.
component TableRow inherits HorizontalLayout {
    in property <RowData> entry;

    height: Theme.row-min;
    spacing: 8px * Theme.scale;

    Text {
        text: entry.label;
        color: Theme.text;
        font-size: Theme.cell-size;
        wrap: no-wrap;
        vertical-alignment: center;
        horizontal-stretch: 3;
        overflow: elide;
    }
    Text {
        text: entry.value;
        color: Theme.text;
        font-size: Theme.cell-size;
        wrap: no-wrap;
        vertical-alignment: center;
        horizontal-stretch: 1;
        horizontal-alignment: right;
    }
}

component TableHead inherits HorizontalLayout {
    in property <string> col0: "";
    in property <string> col1: "";

    height: Theme.head-h;
    spacing: 8px * Theme.scale;

    Text {
        text: col0;
        color: Theme.muted;
        font-size: Theme.cell-size;
        wrap: no-wrap;
        vertical-alignment: center;
        horizontal-stretch: 3;
        overflow: elide;
    }
    Text {
        text: col1;
        color: Theme.muted;
        font-size: Theme.cell-size;
        wrap: no-wrap;
        vertical-alignment: center;
        horizontal-stretch: 1;
        horizontal-alignment: right;
    }
}

// A titled table with a hairline under every row. Rows come from the model: an
// empty list simply leaves the card blank, which is the intended look when the
// server has nothing to report yet.
//
// HOW MANY ROWS SHOW is decided here, from the height the page handed this card:
// a table on a short panel shows the rows that fit at Theme.row-min instead of
// overflowing the card and painting over the footer. The card's height is an
// input (main.slint computes it from the panel), which is what keeps this
// arithmetic acyclic - a height that came from the layout would depend on the
// rows, which depend on the height.
export component TableCard inherits Card {
    in property <TableData> data;

    // Everything in the card that is not a row: padding, title, the gap under
    // it, the column header, and one hairline per row.
    out property <length> row-area: (self.height - Theme.card-padding * 2
        - Theme.title-line - Theme.card-gap - Theme.head-h);

    // Rows at their minimum height; the last one gets the remainder of the card.
    out property <int> visible-rows: min(self.data.rows.length,
        max(1, floor(self.row-area / Theme.row-span)));
    out property <length> row-h: max(Theme.row-min,
        self.row-area / max(1, self.visible-rows) - 1px);

    VerticalLayout {
        padding: Theme.card-padding;
        spacing: Theme.card-gap;

        SectionTitle { text: data.title; }

        VerticalLayout {
            spacing: 0px;
            TableHead { col0: data.col0; col1: data.col1; }
            for row[i] in data.rows: VerticalLayout {
                spacing: 0px;
                if i < root.visible-rows: TableRow { entry: row; height: root.row-h; }
                if i < root.visible-rows: Rectangle {
                    height: 1px;
                    background: Theme.grid;
                }
            }

            // Absorbs the card's leftover height so the table stays pinned to the
            // top. Without a flexible child, a Slint layout packs its content at
            // the end, which drags the title and every row down with it.
            Rectangle {
                vertical-stretch: 1;
                background: transparent;
            }
        }
    }
}
