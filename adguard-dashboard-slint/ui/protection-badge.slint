import { Theme } from "theme.slint";

// Boxed protection state, sitting on its own line under the header: green when
// filtering is on, red when it is off, grey until the first status reply.
// Fixed width: the two labels are the longest strings it has to hold.
export component ProtectionBadge inherits Rectangle {
    in property <bool> known: false;
    in property <bool> on: false;
    in property <string> label: "Protection: unknown";

    width: Theme.badge-w;
    height: Theme.badge-h;
    border-radius: Theme.badge-radius;
    background: !known ? Theme.muted : (on ? Theme.protection-on : Theme.protection-off);

    Text {
        width: 100%;
        height: 100%;
        text: root.label;
        color: Theme.on-badge;
        font-size: Theme.cell-size;
        wrap: no-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
