import { Theme } from "theme.slint";
import { ChartData } from "types.slint";
import { Card } from "card.slint";
import { SectionTitle } from "section-title.slint";
import { BarChart } from "bar-chart.slint";

// One chart in the top row: title, running total, then the bars filling the
// rest. A series with no activity draws no bars at all, which looks broken on
// its own, so it gets a hint instead.
//
// The chart row is the flexible one: its card is a share of whatever the panel
// left over (main.slint), and the bar area takes what the title and the total do
// not.
export component ChartCard inherits Card {
    in property <ChartData> data;

    VerticalLayout {
        padding: Theme.card-padding;
        spacing: Theme.card-gap;

        SectionTitle { text: data.title; }

        Text {
            text: data.total;
            color: Theme.text;
            font-size: Theme.total-size;
            wrap: no-wrap;
        }

        Rectangle {
            vertical-stretch: 1;
            background: transparent;

            BarChart {
                values: data.values;
                bar-color: data.color;
            }

            if data.empty: Text {
                width: 100%;
                height: 100%;
                text: "no activity in this interval";
                color: Theme.muted;
                font-size: Theme.footer-size;
                wrap: no-wrap;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
